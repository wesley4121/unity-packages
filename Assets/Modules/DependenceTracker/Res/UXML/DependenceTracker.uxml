<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Modules/DependenceTracker/Scripts/Editor/DependenceTracker.uss?fileID=7433441132597879392&amp;guid=0b09b6584d697ac48aafc825d3fee9f5&amp;type=3#DependenceTracker" />
        <ui:VisualElement style="flex-direction: column; height: 100%; width: 100%; padding: 10px; gap: 10px;">
        <ui:VisualElement name="VisualElement" style="flex-grow: initial; flex-direction: row; width: auto; height: auto; flex-wrap: wrap; margin-bottom: 0; align-items: stretch; justify-content: space-around; align-self: stretch;">
            <uie:ObjectField name="objectField" label="Select Object" object-type="UnityEngine.GameObject" allow-scene-objects="false" style="margin-bottom: 10px; height: 36px; align-items: stretch; width: 100%; flex-direction: column; align-self: flex-start;" />
            <ui:Button text="Refresh" name="refreshButton" style="height: 33px; -unity-text-align: middle-center; white-space: nowrap; align-items: center; justify-content: flex-end; align-self: flex-start; align-content: flex-start;" />
            <ui:Toggle label="AutoSelect" name="autoSelectToggle" style="justify-content: center; align-items: center; align-self: center;" />
        </ui:VisualElement>
        <ui:Label text="In Assets:" name="AssetsLabel" style="margin-bottom: 5px;" />
        <ui:TreeView name="dependenciesTreeView_Assets" horizontal-scrolling="true" auto-expand="true" show-border="true" reorderable="true" style="flex-grow: 3; height: auto; width: 100%; unity-item-height: 20px; unity-indent-width: 15px;" />
        <ui:Label text="In Packages:" name="PackagesLabel" style="margin-top: 10px; margin-bottom: 5px;" />
        <ui:TreeView name="dependenciesTreeView_Packages" horizontal-scrolling="true" auto-expand="true" show-border="true" reorderable="true" style="flex-grow: 2; height: auto; width: 100%; unity-item-height: 20px; unity-indent-width: 15px;" />
    </ui:VisualElement>
</ui:UXML>
