<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Modules/HierarchyKit/UISpawner/Resources/USS/UISpawner.uss?fileID=7433441132597879392&amp;guid=183516b572a96f9489695786f95e041d&amp;type=3#UISpawner" />
    <engine:VisualElement name="Container" style="flex-grow: 1; justify-content: space-between; align-items: stretch; align-self: stretch; flex-direction: row; flex-wrap: wrap; width: auto; height: auto; padding: 10px; border-radius: 5px;">
        <engine:ScrollView horizontal-scroller-visibility="Auto" style="flex-grow: 1; width: 100%; height: 100%; overflow: scroll; background-color: rgba(56, 56, 56, 0); border: 1px solid rgb(204, 204, 204); border-radius: 5px; padding: 10px; padding-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0;">
            <engine:VisualElement name="DynamicButtonContainer" style="flex-direction: row; margin: 10px; flex-wrap: wrap; padding-top: 3px; padding-left: 3px; padding-right: 3px; padding-bottom: 3px; background-color: rgba(0, 0, 0, 0.39); background-repeat: no-repeat no-repeat; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; justify-content: center; align-items: center; align-self: auto; align-content: center;" />
            <engine:Foldout text="PrefabSetting" name="PrefabSettingFoldout">
                <engine:VisualElement name="PrefabListContainer" style="flex-grow: 1; flex-direction: column; width: 100%; height: auto; gap: 10px;">
                    <engine:VisualElement name="PrefabListControls" style="flex-direction: row; justify-content: flex-start; align-items: center; margin-bottom: 5px; gap: 5px;">
                        <engine:Button text="+" name="AddPrefabButton" style="width: 30px; height: 30px; margin-right: 5px; background-color: rgb(40, 167, 69); color: rgb(255, 255, 255); border-radius: 3px;" />
                        <engine:Button text="-" name="RemovePrefabButton" style="width: 30px; height: 30px; background-color: rgb(220, 53, 69); color: rgb(255, 255, 255); border-radius: 3px;" />
                    </engine:VisualElement>
                    <engine:ListView name="PrefabListView" style="flex-grow: 1; width: 100%; height: auto; border: 1px solid rgb(204, 204, 204); border-radius: 3px; padding: 5px;" />
                </engine:VisualElement>
            </engine:Foldout>
            <engine:Button text="Set Default Prefabs" name="SetDefaultPrefabsButton" style="width: auto; height: auto; margin-top: 10px; background-color: rgb(0, 122, 204); color: rgb(255, 255, 255); border-radius: 3px;" />
        </engine:ScrollView>
    </engine:VisualElement>
</engine:UXML>
